# alt12 — адаптация "general (ALT12).bat" (zapret-discord-youtube)
# Блоки разделены --new

# БЛОК 1: UDP 443 — Общий hostlist (QUIC) — repeats=11
--filter-udp=443
--hostlist=@lists@/list-general.txt
--hostlist=@lists@/list-general-user.txt
--hostlist-exclude=@lists@/list-exclude.txt
--hostlist-exclude=@lists@/list-exclude-user.txt
--ipset-exclude=@lists@/ipset-exclude.txt
--ipset-exclude=@lists@/ipset-exclude-user.txt
--dpi-desync=fake
--dpi-desync-repeats=11
--dpi-desync-fake-quic=@blobs@/quic_initial_www_google_com.bin

--new

# БЛОК 2: UDP Discord/STUN — 2× fake-discord (stun + quic), repeats=3
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--dpi-desync=fake
--dpi-desync-fake-discord=@blobs@/stun.bin
--dpi-desync-fake-discord=@blobs@/quic_initial_dbankcloud_ru.bin
--dpi-desync-fake-stun=@blobs@/quic_initial_dbankcloud_ru.bin
--dpi-desync-repeats=3

--new

# БЛОК 3: TCP альтернативные порты — Discord media — fake+multisplit, fooling=ts, repeats=8, fake-tls
--filter-tcp=2053,2083,2087,2096,8443
--hostlist-domains=discord.media
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=8
--dpi-desync-split-seqovl-pattern=@blobs@/tls_clienthello_www_google_com.bin
--dpi-desync-fake-tls=@blobs@/tls_clienthello_www_google_com.bin

--new

# БЛОК 4: TCP 443 — Google/YouTube — hostfakesplit, fooling=ts, mod
--filter-tcp=443
--hostlist=@lists@/list-google.txt
--ip-id=zero
--dpi-desync=hostfakesplit
--dpi-desync-fooling=ts
--dpi-desync-fake-tls=@blobs@/tls_clienthello_www_google_com.bin
--dpi-desync-hostfakesplit-mod=host=www.google.com
--new

# БЛОК 5: TCP 80,443 — Общий hostlist — fake+multisplit, seqovl=664, fooling=ts, repeats=8, fake-tls, fake-http
--filter-tcp=80,443
--hostlist=@lists@/list-general.txt
--hostlist=@lists@/list-general-user.txt
--hostlist-exclude=@lists@/list-exclude.txt
--hostlist-exclude=@lists@/list-exclude-user.txt
--ipset-exclude=@lists@/ipset-exclude.txt
--ipset-exclude=@lists@/ipset-exclude-user.txt
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=664
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=8
--dpi-desync-split-seqovl-pattern=@blobs@/tls_clienthello_max_ru.bin
--dpi-desync-fake-tls=@blobs@/stun.bin
--dpi-desync-fake-tls=@blobs@/tls_clienthello_max_ru.bin
--dpi-desync-fake-http=@blobs@/tls_clienthello_max_ru.bin

--new

# БЛОК 6: UDP 443 — ipset-all — repeats=11
--filter-udp=443
--ipset=@lists@/ipset-all.txt
--hostlist-exclude=@lists@/list-exclude.txt
--hostlist-exclude=@lists@/list-exclude-user.txt
--ipset-exclude=@lists@/ipset-exclude.txt
--ipset-exclude=@lists@/ipset-exclude-user.txt
--dpi-desync=fake
--dpi-desync-repeats=11
--dpi-desync-fake-quic=@blobs@/quic_initial_www_google_com.bin

--new

# БЛОК 7: TCP 80,443,8443 — ipset-all — fake+multisplit, seqovl=664, fooling=ts, repeats=8, fake-tls, fake-http
--filter-tcp=80,443,8443
--ipset=@lists@/ipset-all.txt
--hostlist-exclude=@lists@/list-exclude.txt
--hostlist-exclude=@lists@/list-exclude-user.txt
--ipset-exclude=@lists@/ipset-exclude.txt
--ipset-exclude=@lists@/ipset-exclude-user.txt
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=664
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=8
--dpi-desync-split-seqovl-pattern=@blobs@/tls_clienthello_max_ru.bin
--dpi-desync-fake-tls=@blobs@/stun.bin
--dpi-desync-fake-tls=@blobs@/tls_clienthello_max_ru.bin
--dpi-desync-fake-http=@blobs@/tls_clienthello_max_ru.bin
