{ config, lib, pkgs, ... }:

{
  services.resolved = {
    enable = true;

    settings = {
      Resolve = {
        # Основные DNS-серверы: Quad9 + AdGuard (оба нероссийские, вне юрисдикции
        # РФ). Указываем IP-адреса, а не домен, чтобы избежать циклической
        # зависимости при разрешении имён. К каждому IP добавляем TLS-имя хоста
        # (для SNI и проверки сертификата при DoT).
        # NB: 1.1.1.1 / 8.8.8.8 сознательно НЕТ — с августа 2026 ТСПУ делает
        # DNAT их UDP-запросов на НСДИ (NXDOMAIN), а DoT/DoH режется на
        # ClientHello. Открытый UDP Quad9/AdGuard при этом работает.
        DNS = lib.mkDefault [
          "9.9.9.9#dns.quad9.net"
          "149.112.112.112#dns.quad9.net"
          "94.140.14.14#dns.adguard-dns.com"
        ];

        # Запасные DNS-серверы — используются, если основные не отвечают.
        # Указываем с TLS-именами, чтобы они тоже работали по DoT.
        FallbackDNS = [
          "76.76.2.0"           # ControlD
          "94.140.15.15"        # AdGuard (второй адрес)
        ];

        # Включаем DNSSEC (проверка цифровых подписей)
        DNSSEC = "true";

        # Режим DNS-over-TLS:
        #   "opportunistic" – использовать TLS, если сервер поддерживает,
        #                    иначе работать без шифрования (не ломает работу).
        #   "true"          – строгий режим: если TLS не работает, сервер игнорируется.
        # Рекомендую "opportunistic" для максимальной живучести.
        DNSOverTLS = "opportunistic";

        # Обрабатываем все DNS-запросы через этот резолвер
        Domains = "~.";
      };
    };
  };

  # Явно говорим системе использовать локальный systemd-resolved
  networking.nameservers = [
    "127.0.0.1"
    "::1"
  ];

  # Порт для локального подключения к T3 Code с мобильных устройств
  networking.firewall.allowedTCPPorts = lib.mkDefault [ 3773 ];
}
